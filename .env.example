# Copy this file to backend/.env and fill in your values
PORT=5000

# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/driveeasy

# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/driveeasy?retryWrites=true&w=majority

# Generate a strong secret key — can be any long random string
JWT_SECRET=replace_with_a_strong_random_secret_key
